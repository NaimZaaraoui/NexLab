# =============================================================================
# NexLab LIMS — Demo Deployment on Vercel + Turso
# Copy this file as .env.local for local testing with a Turso database,
# or set these variables directly in the Vercel project settings.
# =============================================================================

# ── Database (Turso) ──────────────────────────────────────────────────────────
# Get these from: https://turso.tech → your database → Connect
DATABASE_URL=libsql://nexlab-demo-naimzaaraoui.aws-ap-northeast-1.turso.io
DATABASE_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3ODExMDA5ODMsImlkIjoiMDE5ZWIxZTMtNDIwMS03NzBlLWEwYmEtYzBmMzlhYzRkMGIzIiwicmlkIjoiOTliMGMwZjUtMWU1OS00ODIyLTk3YjctZDRkNjExMzg4MTE0In0.tgBkxFJ6GUlpRYUSyxBDjg83bZNbNZ_y2y1FLEYNcuqB2JCO5rDcPIgsOkuSZhZyLpVMzBu9IYlWMZM77OKmDA

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=<generated-32-char-secret>
NEXTAUTH_URL=https://nexlab-demo.vercel.app
AUTH_TRUST_HOST=true

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Enables the demo banner, pre-filled credentials on login, the reset cron,
# and demo license unlock.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Generate with: openssl rand -hex 16
# Vercel passes this automatically as Bearer token to cron routes
CRON_SECRET=<generated-cron-secret>

# ── Misc ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
# Leave empty — Puppeteer PDF is not available on Vercel serverless
# CHROMIUM_PATH=
