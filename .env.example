# Database
# For SQLite: file:./dev.db or file:./prod.db
# For PostgreSQL: postgresql://user:password@host:port/database
DATABASE_URL="file:./dev.db"

# Authentication
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="your-strong-secret-here-min-32-chars"

# Email notifications (Resend)
# Get API key from https://resend.com
RESEND_API_KEY="re_your_api_key_here"

# NextAuth configuration
NEXTAUTH_URL="http://localhost"
AUTH_TRUST_HOST="true"

# Optional: Encryption for SQLite
# Clé de chiffrement pour libSQL (Data Encryption at Rest)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DATABASE_ENCRYPTION_KEY="votre-clé-de-chiffrement"

# Optional but recommended: encrypted database backups (.sqlite.enc)
# If omitted, DATABASE_ENCRYPTION_KEY is used as fallback. Use a stable key and store it outside backups.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACKUP_ENCRYPTION_KEY="your-backup-encryption-key"

# Optional: Deployment URL (used in emails, redirects)
# NEXT_PUBLIC_APP_URL="https://yourdomain.com"
