# ─── Database ────────────────────────────────────────────────────────────────
# For SQLite (local): file:./prod.db
# For production server with absolute path: file:/var/data/nexlab.db
DATABASE_URL="file:./dev.db"

# ─── Authentication ───────────────────────────────────────────────────────────
# REQUIRED. Signs and verifies session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="your-strong-secret-here-min-32-chars"

# REQUIRED. Seals validated medical records cryptographically (HMAC-SHA256).
# NEVER share this key. If lost, existing validated seals cannot be re-verified.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SEAL_SECRET="your-seal-secret-here"

# REQUIRED for print routes. Token to authorize internal PDF generation calls.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INTERNAL_PRINT_TOKEN="your-internal-print-token"

# ─── NextAuth configuration ───────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ─── Database Encryption at Rest ──────────────────────────────────────────────
# Strongly recommended for production. Encrypts the SQLite file on disk.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DATABASE_ENCRYPTION_KEY="64-hex-character-key-here"

# ─── Backup & Cloud Sync ──────────────────────────────────────────────────────
# BACKUP_ENCRYPTION_KEY: Recommended to use a separate key from DATABASE_ENCRYPTION_KEY.
# If omitted, DATABASE_ENCRYPTION_KEY is used. Store this key OUTSIDE your backups!
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACKUP_ENCRYPTION_KEY="64-hex-character-key-here"

# EXTERNAL_BACKUP_DIR: Free cloud backup via Google Drive / Dropbox Desktop
# Point this to your Google Drive folder on the server. NexLab will copy 
# the nightly backup here automatically.
# EXTERNAL_BACKUP_DIR="C:\Users\Labo\Google Drive\Sauvegardes NexLab"

# ─── Email notifications (Resend) ─────────────────────────────────────────────
# Get API key from https://resend.com
RESEND_API_KEY="re_your_api_key_here"

# ─── Deployment ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL="https://yourdomain.com"
