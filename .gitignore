# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build
/dist
/output-standalone
/dist

# misc
.DS_Store
*.pem
/.git-meta

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# local databases and runtime data
*.db
*.db-shm
*.db-wal
dev.backup-*.db*
*.db.backup
temp.db
diagnostic.json
tests_response.json
groups.json
/logs
/backups
/database-checkpoints
/ngrok

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated prisma client output (regenerated on install via postinstall)
/app/generated/prisma/*.js
/app/generated/prisma/*.ts
/app/generated/prisma/*.d.ts
/app/generated/prisma/libquery_engine*
/app/generated/prisma/query_engine*
/app/generated/prisma/schema.prisma

# uploads
/public/uploads/

/nexlab-install
